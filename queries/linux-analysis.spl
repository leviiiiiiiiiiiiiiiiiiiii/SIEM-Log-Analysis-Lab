# Linux analysis
index="test" sourcetype="linux_secure"

# Failed SSH logins
index="test" sourcetype="linux_secure" "Failed password"

# Failed logins by source IP
index="test" sourcetype="linux_secure" "Failed password" | rex "from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})" | stats count by src_ip | sort - count

# SSH brute-force detection
index="test" sourcetype="linux_secure" "Failed password" | rex "from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})" | bin _time span=5m | stats count by _time src_ip | where count >= 5
